# Login DB (Prisma): MySQL exposed on host port 800 by docker-compose.
# Example: mysql://user:example_user_password@localhost:800/mydb
DATABASE_URL=""

# NextAuth settings.
NEXTAUTH_URL=http://localhost:3000/
NEXTAUTH_SECRET=

# App DB (Prisma-App): MySQL exposed on host port 800 by docker-compose.
# Example: mysql://user:example_user_password@localhost:800/mydb
DATABASE_MAIN_URL=""

# MongoDB for login logs: MongoDB exposed on host port 801 by docker-compose.
# Example: mongodb://admin:example_password@localhost:801/admin?authSource=admin
MONGODB_URI_LOG_LOGIN=

# Twelve Data API key for stock endpoint.
STOCK_API_KEY=""
