generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prismaApp"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_MAIN_URL")
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum TradeType {
  BUY
  SELL
}

enum Country {
  THAILAND
  USA
}

enum Currency {
  THB
  USD
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  TRANSFER
}

//////////////////////////////////////////////////
// USER (ID มาจาก LOGIN SYSTEM)
//////////////////////////////////////////////////

model User {
  id          String   @id    
  firstName   String
  lastName    String
  birthDate   DateTime
  idCard      String   @unique
  createdAt   DateTime @default(now())

  accounts        BankAccount[]
  holdings        Holding[]
  transactions    TransactionStock[]
  pinnedStocks    PinnedStock[]
}

//////////////////////////////////////////////////
// BANK ACCOUNT
//////////////////////////////////////////////////

model BankAccount {
  id        String    @id @default(cuid())
  userId    String
  country   Country
  currency  Currency
  balance   Decimal   @db.Decimal(15,2) @default(0)
  createdAt DateTime  @default(now())

  user              User @relation(fields: [userId], references: [id])
  logs              AccountLog[]
  sentTransfers     TransferTransaction[] @relation("FromAccount")
  receivedTransfers TransferTransaction[] @relation("ToAccount")

  @@unique([userId, country, currency])
  @@index([userId])
}

//////////////////////////////////////////////////
// TRANSFER
//////////////////////////////////////////////////

model TransferTransaction {
  id            BigInt  @id @default(autoincrement())
  fromAccountId String
  toAccountId   String
  amount        Decimal @db.Decimal(15,2)
  createdAt     DateTime @default(now())

  fromAccount BankAccount @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount   BankAccount @relation("ToAccount", fields: [toAccountId], references: [id])

  logs AccountLog[]

  @@index([fromAccountId])
  @@index([toAccountId])
}

//////////////////////////////////////////////////
// ACCOUNT LOG
//////////////////////////////////////////////////

model AccountLog {
  id            BigInt  @id @default(autoincrement())
  accountId     String
  transferId    BigInt?
  type          TransactionType
  amount        Decimal @db.Decimal(15,2)
  balanceBefore Decimal @db.Decimal(15,2)
  balanceAfter  Decimal @db.Decimal(15,2)
  createdAt     DateTime @default(now())

  account   BankAccount @relation(fields: [accountId], references: [id])
  transfer  TransferTransaction? @relation(fields: [transferId], references: [id])

  @@index([accountId])
}

//////////////////////////////////////////////////
// HOLDING
//////////////////////////////////////////////////

model Holding {
  userId    String
  stockId   String
  quantity  Decimal @db.Decimal(15,4)
  avgCost   Decimal @db.Decimal(15,4)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, stockId])
}

//////////////////////////////////////////////////
// STOCK TRANSACTION
//////////////////////////////////////////////////

model TransactionStock {
  id        BigInt   @id @default(autoincrement())
  userId    String
  stockId   String
  type      TradeType
  quantity  Decimal  @db.Decimal(15,4)
  price     Decimal  @db.Decimal(15,4)
  tradeDate DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

//////////////////////////////////////////////////
// PINNED STOCK
//////////////////////////////////////////////////

model PinnedStock {
  id        BigInt @id @default(autoincrement())
  userId    String
  stockId   String

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, stockId])
}

/////////////////////////////////////////////////
// Stock Price History
//////////////////////////////////////////////////

model StockHistory {
  id        BigInt @id @default(autoincrement())
  symbol    String
  price     Float
  time      DateTime

  @@unique([symbol, time])
}

/////////////////////////////////////////////////
// Stock Price History(dayly)
//////////////////////////////////////////////////

model StockHistoryDaily {
  id        BigInt @id @default(autoincrement())
  symbol    String
  price     Float
  time      DateTime

  @@unique([symbol, time])
}
